  "goldenEventSequences": [
    {
      "id": "G01-human-wins",
      "initial": {
        "c": "c_alpha",
        "membership": "NONE",
        "titleRevision": 4,
        "titleOwner": "automation"
      },
      "events": [
        "job reads title revision 4",
        "human sets title revision 5, human ownership",
        "model result for revision 4 arrives"
      ],
      "expected": {
        "commit": false,
        "titleRevision": 5,
        "reason": "stale-target-or-human-protected"
      }
    },
    {
      "id": "G02-related-does-not-hide",
      "initial": {
        "c": "c_alpha",
        "membership": "NONE",
        "primary": null,
        "related": [
          "t_a",
          "t_b"
        ]
      },
      "events": [
        "render pro-default-none"
      ],
      "expected": {
        "uncollectedContains": [
          "c_alpha"
        ],
        "activityContribution": {
          "t_a": "none",
          "t_b": "none"
        }
      }
    },
    {
      "id": "G03-native-membership-change",
      "initial": {
        "c": "c_alpha",
        "membership": "NONE",
        "primary": "t_a"
      },
      "events": [
        "model reads NONE revision 2",
        "native owner commits PROJECT revision 3",
        "model attempts apply revision 2"
      ],
      "expected": {
        "modelCommit": false,
        "nativeMembership": "PROJECT",
        "oldHumanPlacement": "retained-ineligible"
      }
    },
    {
      "id": "G04-undo-structural-conflict",
      "initial": {
        "operation": "merge_1",
        "writeSet": [
          "topic_a",
          "topic_b",
          "placement_a",
          "redirect_b"
        ]
      },
      "events": [
        "merge commits",
        "human changes placement_a",
        "undo merge_1"
      ],
      "expected": {
        "inverseWrites": 0,
        "next": "explicit-new-compensation-plan"
      }
    },
    {
      "id": "G05-dispatch-crash",
      "initial": {
        "reservationMicros": 30000,
        "billingProfile": "bill_1"
      },
      "events": [
        "reserve",
        "persist dispatched marker",
        "send request",
        "worker dies before result"
      ],
      "expected": {
        "automaticResendCount": 0,
        "reservation": "held",
        "state": "outcome-unknown"
      }
    },
    {
      "id": "G06-two-scopes-budget",
      "initial": {
        "installationRemainingMicros": 40000,
        "scopeARemainingMicros": 40000,
        "scopeBRemainingMicros": 40000
      },
      "events": [
        "scope A reserves 30000",
        "scope B attempts reserve 30000"
      ],
      "expected": {
        "successfulReservations": 1,
        "installationRemainingMicros": 10000
      }
    },
    {
      "id": "G07-legacy-ambiguity",
      "initial": {
        "legacyPlacements": [
          {
            "c": "c_alpha",
            "topic": "t_a",
            "owner": "human",
            "locked": true
          },
          {
            "c": "c_alpha",
            "topic": "t_b",
            "owner": "human",
            "locked": true
          }
        ]
      },
      "events": [
        "prepare migration"
      ],
      "expected": {
        "preservedRows": 2,
        "chosenPrimary": null,
        "status": "primary-resolution-required",
        "freeReachable": true
      }
    },
    {
      "id": "G08-hard-exclude-not-dismiss",
      "initial": {
        "pairExclusion": [
          "c_alpha",
          "t_a"
        ],
        "dismissFingerprint": "proposal_old"
      },
      "events": [
        "new evidence arrives",
        "model recommends t_a with a new model version"
      ],
      "expected": {
        "automaticApply": false,
        "pairConstraint": "unchanged",
        "requires": "new explicit human解除排除"
      }
    },
    {
      "id": "G09-new-chat-not-next-chat",
      "initial": {
        "canBindNewConversationIntent": false,
        "topic": "t_a"
      },
      "events": [
        "open native new chat",
        "another tab opens existing c_beta"
      ],
      "expected": {
        "newPlacementCount": 0,
        "next": "explicit collect current conversation after independent qualification"
      }
    }
  ]
